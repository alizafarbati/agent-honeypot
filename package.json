{
  "name": "agent-honeypot",
  "version": "0.1.0",
  "description": "A defensive honeypot for LLM agents. MCP tool servers, canary documents, and fingerprinting to detect and study unauthorized AI agents. Research prototype — all data synthetic.",
  "type": "module",
  "main": "dist/surface/mcpservers/finance-warehouse/mcp_server.js",
  "bin": {
    "agent-honeypot": "bin/agent-honeypot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/surface/mcpservers/finance-warehouse/mcp_server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.mjs tests/evolution.test.mjs tests/analytics_hardening.test.mjs tests/security.test.mjs tests/integration.test.mjs",
    "dash": "node control/dash/server.mjs",
    "seed": "node scripts/seed.mjs",
    "report": "node control/report/generator.mjs",
    "doctor": "node bin/agent-honeypot.mjs doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "llm-agents",
    "honeypot",
    "deception",
    "mcp",
    "model-context-protocol",
    "prompt-injection",
    "ai-security",
    "threat-intelligence"
  ],
  "license": "MIT"
}
