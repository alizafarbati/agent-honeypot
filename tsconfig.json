{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["surface/**/*.ts", "surface/**/*.mjs", "capture/**/*.mjs", "evolution/**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}
