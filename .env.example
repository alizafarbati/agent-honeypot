# Runtime state is JSONL/local files unless these are set.
# All integrations are opt-in; unset variables fall back to lab mode.

# Event bus (lab fallback: capture/bus/bus.jsonl)
# AGENT_HONEYPOT_NATS_URL=nats://localhost:4222

# SIEM webhook (lab fallback: control/siem/deliveries.jsonl)
# AGENT_HONEYPOT_SIEM_URL=https://siem.example.com/ingest
# AGENT_HONEYPOT_SIEM_TOKEN=changeme

# MISP push (lab fallback: control/soar/misp_out.jsonl)
# AGENT_HONEYPOT_MISP_URL=https://misp.example.com
# AGENT_HONEYPOT_MISP_KEY=changeme

# LLM-based candidate generation (lab fallback: deterministic templates)
# AGENT_HONEYPOT_LLM_URL=https://llm.example.com/v1/generate

# Tracing (lab fallback: console spans)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Dashboard / tenant API ports
# AGENT_HONEYPOT_DASH_PORT=9079
# AGENT_HONEYPOT_TENANT_API_PORT=9080

# Shard count for consistent-hash routing
# AGENT_HONEYPOT_SHARDS=8
