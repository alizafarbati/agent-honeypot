# agent-honeypot configuration.
# All integrations are opt-in. Unset variables fall back to local-lab mode:
# events, dashboards, and reports use files under data/ with no network access.

# Where all runtime state lives (sessions, ledger, bandit state, reports).
# Default: <repo>/data
# AGENT_HONEYPOT_DATA_DIR=/var/lib/agent-honeypot

# Event bus (fallback: data/bus.jsonl)
# AGENT_HONEYPOT_NATS_URL=nats://localhost:4222

# SIEM webhook (fallback: data/siem_deliveries.jsonl)
# AGENT_HONEYPOT_SIEM_URL=https://siem.example.com/ingest
# AGENT_HONEYPOT_SIEM_TOKEN=changeme

# MISP push (fallback: data/misp_out.jsonl)
# AGENT_HONEYPOT_MISP_URL=https://misp.example.com
# AGENT_HONEYPOT_MISP_KEY=changeme

# LLM-based candidate generation in the evolution engine
# (fallback: deterministic templates)
# AGENT_HONEYPOT_LLM_URL=https://llm.example.com/v1/generate

# Tracing (fallback: console spans)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Dashboard / tenant API ports
# AGENT_HONEYPOT_DASH_PORT=9079
# AGENT_HONEYPOT_TENANT_API_PORT=9080

# Shard count for consistent-hash routing
# AGENT_HONEYPOT_SHARDS=8
